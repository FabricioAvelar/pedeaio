# .env.example — ESTE arquivo vai para o Git.
# Copie para .env e preencha os valores:  cp .env.example .env

# Gere com: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# True apenas em desenvolvimento
DEBUG=False

# Domínios separados por vírgula, sem espaço
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000

DB_ENGINE=django.db.backends.postgresql
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Caminho do admin (troque em produção)
ADMIN_URL=admin/